{
  "name": "dither-ui",
  "version": "0.1.0",
  "description": "Dithered UI toolkit for Vue 3 — composable ordered-dither charts (area, line, bar, pie, radar) on one tiny canvas engine, plus generative avatars, buttons, gradient washes and more.",
  "type": "module",
  "main": "./solid/index.ts",
  "module": "./solid/index.ts",
  "types": "./solid/index.ts",
  "exports": {
    ".": "./solid/index.ts",
    "./solid": "./solid/index.ts",
    "./solid-stylex": "./solid-stylex/index.ts",
    "./engine/*": "./engine/*",
    "./tailwind/*": "./tailwind/*",
    "./solid/*": "./solid/*",
    "./solid-stylex/*": "./solid-stylex/*"
  },
  "files": [
    "engine",
    "tailwind",
    "solid",
    "solid-stylex",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "clsx": "^2.1.0",
    "d3-scale": "^4.0.0",
    "d3-shape": "^3.2.0",
    "solid-js": "^1.9.0",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "@stylexjs/stylex": {
      "optional": true
    }
  },
  "keywords": [
    "vue",
    "charts",
    "dither",
    "canvas",
    "ui-kit",
    "generative"
  ],
  "license": "MIT"
}
