{
  "name": "restyle",
  "version": "0.1.0",
  "private": true,
  "description": "Writes Tailwind-classed code in a reader's styling system: a scoped stylesheet, CSS Modules or StyleX, and generates the kit's StyleX layer.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./utility-map": "./src/utility-map.ts",
    "./stylex-layer": "./src/stylex-layer-solid.ts"
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "dither-kit": "*",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3"
  },
  "devDependencies": {
    "@stylexjs/stylex": "0.19.1",
    "rstack": "^0.8.5"
  },
  "license": "MIT"
}
