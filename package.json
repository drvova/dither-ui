{
  "name": "dither-kit-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rs dev --environment web",
    "build": "vue-tsc -b && rs build && node scripts/kit-css.mjs && node scripts/prerender.mjs",
    "build:css": "node scripts/kit-css.mjs",
    "frames": "node scripts/render-frames.mjs",
    "films": "rs test tests/films.spec.ts -u",
    "preview": "rs preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "rs test",
    "test:watch": "rs test watch",
    "lint": "rs lint && eslint \"**/*.vue\"",
    "format": "rs fmt",
    "check": "rs check && eslint \"**/*.vue\" && vue-tsc --noEmit"
  },
  "dependencies": {
    "@clayzo/webgl-player": "0.3.18",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "html-to-image": "^1.11.13",
    "tailwind-merge": "^2.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@clayzo/animation": "0.3.18",
    "@eslint/js": "^10.0.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/node": "^22.20.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "rstack": "^0.8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.64.0",
    "vue-tsc": "^2.2.0"
  }
}
