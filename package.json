{
  "name": "dither-ui-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w site",
    "build:css": "node packages/tasks/src/kit-css.mjs packages/site/.output/public/kit/dither-kit.css",
    "preview": "npm run preview -w site",
    "frames": "node packages/tasks/src/render-frames.mjs",
    "demo:agent": "node packages/tasks/src/agent-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "rs test && npm test --workspaces --if-present",
    "test:watch": "rs test watch",
    "lint": "rs lint",
    "format": "rs fmt",
    "check": "rs check && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "jsdom": "^29.1.1",
    "rstack": "^0.8.5",
    "typescript": "~5.6.3"
  }
}
